// Cloudflare Worker 的設定。部署：npx wrangler deploy（在這個資料夾執行）
{
  "name": "asuka-map",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../viewer",
    // 靜態檔案由 Cloudflare 直接送出，不佔 Worker 每天的請求額度；其他路徑（/data、/mcp）才交給 Worker
    "binding": "ASSETS"
  },
  "r2_buckets": [{ "binding": "MAP", "bucket_name": "asuka-map-apac" }],
  // 不開預覽網址：地圖只有 workers.dev 這一個入口
  "preview_urls": false
}
