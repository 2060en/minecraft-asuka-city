// Cloudflare Worker 的設定。部署：npx wrangler deploy（在這個資料夾執行）
{
  "name": "asuka-map",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../viewer",
    "binding": "ASSETS",
    // 每個請求都先經過 Worker 檢查登入，連檢視網頁本身也是
    "run_worker_first": true
  },
  "r2_buckets": [{ "binding": "MAP", "bucket_name": "asuka-map-apac" }],
  // 不開預覽網址：地圖只有 workers.dev 這一個入口
  "preview_urls": false
  // ACCESS_TEAM_DOMAIN、ACCESS_AUD 存成 Worker 的機密（wrangler secret put），不寫在這裡：
  // 這個 repo 是公開的，而且這裡寫 vars 的話，每次部署都會蓋掉。步驟見 tools/world-backup/README.md
}
