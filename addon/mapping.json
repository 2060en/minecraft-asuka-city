{
  "_說明": "對照表：每一種自製方塊在原味版換成哪一個原版方塊、狀態怎麼對應。轉換程式、文件都以這張表為準；沒有登記的自製方塊不能放進世界。見 docs/addon.md 的「對照表」",
  "asukatech:door_light_gray": {
    "vanilla": "minecraft:spruce_door",
    "states": {
      "minecraft:cardinal_direction": "minecraft:cardinal_direction",
      "asukatech:upper": "upper_block_bit",
      "asukatech:open": "open_bit",
      "asukatech:hinge_right": "door_hinge_bit"
    },
    "_實測": "door_hinge_bit 與朝向的對應，作者實測正確（2026-11-03）"
  },
  "asukatech:door_white": {
    "same_as": "asukatech:door_light_gray"
  },
  "asukatech:trapdoor_light_gray": {
    "vanilla": "minecraft:spruce_trapdoor",
    "states": {
      "minecraft:cardinal_direction": {
        "to": "direction",
        "values": {
          "east": 0,
          "west": 1,
          "south": 2,
          "north": 3
        }
      },
      "minecraft:vertical_half": {
        "to": "upside_down_bit",
        "values": {
          "bottom": false,
          "top": true
        }
      },
      "asukatech:open": "open_bit"
    },
    "_實測": "原版地板門 direction 0～3 的對應，作者實測正確（2026-11-03）"
  },
  "asukatech:trapdoor_white": {
    "same_as": "asukatech:trapdoor_light_gray"
  },
  "asukatech:coffee_cup": {
    "vanilla": "minecraft:air",
    "states": {}
  },
  "asukatech:screen": {
    "vanilla": "minecraft:glow_frame",
    "states": {
      "minecraft:block_face": {
        "to": "facing_direction",
        "values": {
          "down": 0,
          "up": 1,
          "north": 2,
          "south": 3,
          "west": 4,
          "east": 5
        }
      }
    },
    "block_entity": "空的發光物品框架（GlowItemFrame）",
    "_待實測": "facing_direction 0～5 的對應、方塊實體要怎麼補"
  },
  "_實體": {
    "_說明": "自製實體在原味版裡直接刪掉（作者接受，2026-11-03）",
    "delete": [
      "asukatech:plate",
      "asukatech:bowl",
      "asukatech:cup",
      "asukatech:knife",
      "asukatech:fork",
      "asukatech:spoon",
      "asukatech:chopsticks"
    ]
  }
}
