{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.asukatech.belt": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "part_visibility": [
        {
          "*": false
        },
        {
          "root": true
        },
        {
          "belt_straight": "q.property('asukatech:shape') == 1"
        },
        {
          "belt_curve": "q.property('asukatech:shape') == 2"
        },
        {
          "belt_slope": "q.property('asukatech:shape') == 3"
        },
        {
          "cap_s": "q.property('asukatech:cap_s')"
        },
        {
          "cap_n": "q.property('asukatech:cap_n')"
        },
        {
          "cap_e": "q.property('asukatech:cap_e')"
        }
      ]
    }
  }
}
